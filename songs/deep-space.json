    { "id": "halftime", "beats": 8, "sections": { "intro": 0, "calm": 0, "wonder": 0, "drift": 0.25, "tension": 0, "build": 0, "release": 0 }, "pattern": "k . h . h . h . s . h . h . h? . | k . h . h . k . s . h . h . h o" },
    { "id": "tick", "beats": 4, "sections": { "intro": 0, "calm": 0, "wonder": 0, "drift": 0, "build": 0, "peak": 0, "release": 0 }, "pattern": "k . m m . m m . k . m m . m m m" },
    { "id": "dr_build", "beats": 4, "sections": { "intro": 0, "calm": 0, "wonder": 0, "drift": 0, "tension": 0, "danger": 0, "peak": 0, "release": 0 }, "pattern": "k . h . k . h . k . h . k . h s?" },

    { "id": "fill_snare", "beats": 4, "fill": true, "sections": { "intro": 0, "calm": 0, "wonder": 0, "tension": 0, "release": 0 }, "pattern": "k . . . s . . . s . s . s s s! s!" },
    { "id": "fill_toms", "beats": 4, "fill": true, "sections": { "intro": 0, "calm": 0, "wonder": 0, "tension": 0, "build": 0, "release": 0 }, "pattern": "k . h . s . h . t . t . t t s! s!" },
