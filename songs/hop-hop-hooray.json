{
  "format": 2,
  "name": "Hop Hop Hooray",
  "bpm": 138,
  "key": "C",
  "scale": "major",
  "stepsPerBeat": 4,
  "beatsPerBar": 4,
  "swing": 0.35,
  "variation": 0.25,
  "blockChange": 0.15,
  "fillChance": 0.5,
  "layerChurn": 0.1,
  "progStickiness": 1.3,
  "transitBars": 2,
  "humanize": 0.08,
  "leadIn": 2,
  "breath": { "every": 64, "bars": [4, 8], "keep": ["pad", "twinkle"] },
  "startSection": "intro",
  "master": { "gain": 1.15 },
  "fx": {
    "echo": { "beats": 0.5, "feedback": 0.25, "damp": 0.45, "level": 0.3 },
    "reverb": { "size": 0.7, "damp": 0.5, "level": 0.25 },
    "echoToReverb": 0.2
  },

  "moods": {
    "relaxed": { "sections": { "meadow": 1 } },
    "wonder": { "sections": { "bonus": 1 } },
    "exploring": { "sections": { "overworld": 1 } },
    "tension": { "sections": { "underground": 1 } },
    "danger": { "sections": { "castle": 1 } },
    "action": { "sections": { "star": 1 } }
  },

  "stingers": [
    { "id": "discovery", "at": "step", "beats": 4, "chords": "IV:2 V(7):2", "duck": 0.5, "parts": [
      { "track": "lead",    "pattern": "0 1 2 3 1 2 3 4 2 3 4 5 6 -*3" },
      { "track": "twinkle", "pattern": ". . . . . . . . . . . . 6 -*3" } ] },
    { "id": "alert", "at": "beat", "beats": 4, "duck": 0.5, "parts": [
      { "track": "lead",  "mode": "key", "pattern": "7 7# 8 . 7 7# 8 . 7 7# 8 . 9! -*3" },
      { "track": "bass",  "pattern": "0 . 0 . 0 . 0 . 0 . 0 . 0 . 0 ." },
      { "track": "drums", "pattern": "k . s . k . s . k s k s s! s! s! s!" } ] },
    { "id": "jump", "at": "beat", "beats": 4, "chords": "V", "duck": 0.6, "parts": [
      { "track": "lead",  "mode": "key", "pattern": "0 2 4 7 9 11 14 -*9" },
      { "track": "drums", "pattern": "t . t . t . t t s s s s c! .*3" } ] },
    { "id": "reward", "at": "step", "beats": 1, "duck": 0, "parts": [
      { "track": "twinkle", "mode": "key", "pattern": "6 9 - -" } ] }
  ],

  "instruments": {
    "square":  { "type": "pulse", "duty": 0.5, "env": { "a": 0.002, "d": 0.12, "s": 0.55, "r": 0.04 }, "vibrato": { "depth": 0.08, "rate": 6, "delay": 0.2 }, "cutoff": 6500 },
    "stab":    { "poly": 3, "type": "pulse", "duty": 0.25, "env": { "a": 0.002, "d": 0.09, "s": 0.2, "r": 0.04 }, "cutoff": 4500 },
    "tri":     { "type": "triangle", "env": { "a": 0.002, "d": 0.25, "s": 0.7, "r": 0.04 }, "cutoff": 4000 },
    "sparkle": { "type": "pulse", "duty": 0.125, "env": { "a": 0.001, "d": 0.25, "s": 0, "r": 0.2 }, "cutoff": 7000 },
    "ocarina": { "poly": 6, "type": "wave", "wave": "sine", "smooth": true, "unison": 2, "detune": 6, "env": { "a": 0.25, "d": 1, "s": 0.75, "r": 0.8 }, "vibrato": { "depth": 0.1, "rate": 4.5, "delay": 0.4 }, "cutoff": 2500 },
    "noise":   { "type": "drums", "kit": "chip", "cutoff": 12000 }
  },

  "tracks": [
    { "id": "pad", "instrument": "ocarina", "octave": 4, "volume": 0.12, "pan": -0.1, "echo": 0.1, "reverb": 0.5, "follow": true, "stickiness": 3, "color": "#a79bff", "clips": ["pad_hold", "bonus", "under"] },
    { "id": "bass", "instrument": "tri", "octave": 2, "volume": 0.34, "pan": 0, "echo": 0, "reverb": 0.05, "follow": true, "stickiness": 2.5, "color": "#5b8cff", "clips": ["hold", "oompah", "bounce", "walk", "calypso", "octaves", "sneak", "castle"] },
    { "id": "stabs", "instrument": "stab", "octave": 4, "volume": 0.12, "pan": -0.3, "echo": 0.15, "reverb": 0.2, "stickiness": 2, "color": "#6ff0a8", "clips": ["offbeat", "stabs_calypso", "star", "build", "tension"] },
    { "id": "lead", "instrument": "square", "octave": 4, "volume": 0.2, "pan": 0.15, "echo": 0.2, "reverb": 0.25, "stickiness": 1.5, "color": "#ff8a5c", "clips": ["theme", "theme_star", "theme_hop", "creep", "lead_castle", "climb", "fanfare"] },
