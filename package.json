{
  "name": "stardrift-engine",
  "version": "0.1.0",
  "description": "Procedural music engine for games: endless, varying chiptune and hybrid music that follows the game's mood. Web Audio, no dependencies.",
  "keywords": [
    "music",
    "procedural",
    "generative",
    "adaptive-music",
    "game-audio",
    "chiptune",
    "web-audio",
    "audioworklet",
    "gamedev"
  ],
  "homepage": "https://github.com/ahackel/stardrift-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahackel/stardrift-engine.git"
  },
  "bugs": "https://github.com/ahackel/stardrift-engine/issues",
  "author": "Andreas Hackel",
  "license": "MIT",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": "./src/*",
    "./library/*": "./library/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "src",
    "dist",
    "library",
    "SONG_FORMAT.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "test": "node tools/test.mjs",
    "render": "node tools/render.mjs",
    "bench": "node tools/bench.mjs",
    "prepublishOnly": "npm test"
  }
}
