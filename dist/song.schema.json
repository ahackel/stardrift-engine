{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stardrift song",
  "type": "object",
  "required": [
    "tracks",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 2
    },
    "name": {
      "type": "string"
    },
    "bpm": {
      "type": "number",
      "minimum": 30,
      "maximum": 300
    },
    "key": {
      "enum": [
        "C",
        "C#",
        "Db",
        "D",
        "D#",
        "Eb",
        "E",
        "F",
        "F#",
        "Gb",
        "G",
        "G#",
        "Ab",
        "A",
        "A#",
        "Bb",
        "B"
      ]
    },
    "scale": {
      "enum": [
        "major",
        "ionian",
        "dorian",
        "phrygian",
        "lydian",
        "mixolydian",
        "minor",
        "aeolian",
        "locrian",
        "harmonicMinor"
      ]
    },
    "stepsPerBeat": {
      "type": "integer",
      "minimum": 1,
      "description": "default 4"
    },
    "beatsPerBar": {
      "type": "integer",
      "minimum": 1,
      "description": "default 4"
    },
    "swing": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.6
    },
    "humanize": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.3
    },
    "variation": {},
    "blockChange": {},
    "fillChance": {},
    "layerChurn": {},
    "progStickiness": {},
    "transitBars": {},
    "leadIn": {},
    "breath": {
      "$ref": "#/definitions/breath"
    },
    "startSection": {
      "type": "string",
      "description": "the section it starts in (default: the first)"
    },
    "startMood": {
      "type": "string",
      "description": "the mood whose flow plays while the game asks for none (default: the first mood with a flow)"
    },
    "master": {
      "type": "object",
      "properties": {
        "glue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "fx": {},
    "instruments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/instrument"
      },
      "description": "{ id: instrument }"
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/track"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/block"
      },
      "description": "the clips: short patterns that tracks play"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/section"
      }
    },
    "progressions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/progression"
      }
    },
    "moods": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/mood"
      },
      "description": "{ relaxed, wonder, exploring, tension, danger, action: { sections } }"
    },
    "stingers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/stinger"
      },
      "description": "discovery, alert, jump, reward"
    }
  },
  "definitions": {
    "instrument": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "pulse",
            "triangle",
            "wave",
            "string",
            "fm",
            "bowed",
            "sample",
            "drums"
          ]
        },
        "poly": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "notes at once (chords); 1: a new note ends the last"
        },
        "arp": {
          "type": "number",
          "minimum": 1,
          "maximum": 60,
          "description": "runs chords as a chip arpeggio, notes per second"
        },
        "arpChord": {
          "type": "boolean"
        },
        "wave": {
          "oneOf": [
            {
              "enum": [
                "soft",
                "sine",
                "saw",
                "warm",
                "organ",
                "hollow"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 15
              },
              "minItems": 32,
              "maxItems": 32
            }
          ]
        },
        "smooth": {
          "type": "boolean",
          "description": "no 4-bit staircase"
        },
        "duty": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.5
        },
        "pwm": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4
            },
            "rate": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 8
            }
          }
        },
        "string": {
          "type": "object",
          "properties": {
            "decay": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10
            },
            "bright": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mute": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "fm": {
          "type": "object",
          "properties": {
            "ratio": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 8
            },
            "index": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "env": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "feedback": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.5
            }
          }
        },
        "bow": {
          "type": "object",
          "properties": {
            "pressure": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "position": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "sample": {
          "type": "string",
          "description": "a recording in the library, e.g. cello, flute, violins"
        },
        "kit": {
          "oneOf": [
            {
              "enum": [
                "clean",
                "orchestra",
                "rock",
                "chip"
              ]
            },
            {
              "type": "object",
              "description": "per-pad overrides { k: { pitch, decay, level } }"
            }
          ]
        },
        "preset": {
          "enum": [
            "clean",
            "orchestra",
            "rock",
            "chip"
          ]
        },
        "unison": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        },
        "detune": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "ensemble": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "breath": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "env": {
          "type": "object",
          "properties": {
            "a": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 4
            },
            "d": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 6
            },
            "s": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "r": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 8
            }
          }
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "glide": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "scoop": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "vibrato": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rate": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 12
            },
            "delay": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "body": {
          "oneOf": [
            {
              "enum": [
                "violin",
                "cello",
                "strings",
                "horn",
                "brass",
                "ah",
                "oh",
                "oo",
                "ee"
              ]
            },
            {
              "type": "array"
            }
          ]
        },
        "wah": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            },
            "beats": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 8
            },
            "resonance": {
              "type": "number",
              "minimum": 1,
              "maximum": 10
            },
            "mode": {
              "enum": [
                "note"
              ]
            }
          }
        },
        "drive": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "amp": {
          "enum": [
            "guitar",
            "bass"
          ]
        },
        "cutoff": {
          "type": "number",
          "minimum": 60,
          "maximum": 16000
        },
        "resonance": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 6
        },
        "filter": {
          "enum": [
            "low",
            "high"
          ]
        },
        "swell": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "filterEnv": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "decay": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 2
            }
          }
        },
        "crush": {
          "type": "object",
          "properties": {
            "bits": {
              "type": "number",
              "minimum": 2,
              "maximum": 12
            },
            "rate": {
              "type": "number",
              "minimum": 1000,
              "maximum": 48000
            }
          }
        },
        "eq": {
          "type": "object",
          "properties": {
            "low": {
              "type": "number",
              "minimum": -12,
              "maximum": 12
            },
            "mid": {
              "type": "number",
              "minimum": -12,
              "maximum": 12
            },
            "midHz": {
              "type": "number",
              "minimum": 200,
              "maximum": 5000
            },
            "high": {
              "type": "number",
              "minimum": -12,
              "maximum": 12
            }
          }
        },
        "phaser": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            },
            "beats": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 16
            },
            "feedback": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.9
            }
          }
        },
        "chorus": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            },
            "beats": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 16
            },
            "mode": {
              "enum": [
                "flanger"
              ]
            }
          }
        },
        "tremolo": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            },
            "beats": {
              "type": "number",
              "minimum": 0.0625,
              "maximum": 4
            }
          }
        },
        "autopan": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            },
            "beats": {
              "type": "number",
              "minimum": 0.125,
              "maximum": 16
            }
          }
        }
      }
    },
    "track": {
      "type": "object",
      "required": [
        "id",
        "instrument",
        "clips"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "unique"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "instrument": {
          "type": "string",
          "description": "an id in \"instruments\""
        },
        "octave": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "clips": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "a block id"
          },
          "description": "the blocks it plays"
        },
        "mode": {
          "enum": [
            "chord",
            "scale",
            "key"
          ]
        },
        "follow": {
          "type": "boolean",
          "description": "held notes move with the chord"
        },
        "stickiness": {
          "type": "number",
          "minimum": 0,
          "description": "how much it keeps its block (default 1.5)"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "echo": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reverb": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "double": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pump": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fade": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "beats"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "unique"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "beats": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 64,
          "description": "its length; the pattern has beats × stepsPerBeat steps"
        },
        "pattern": {
          "type": "string",
          "description": "steps, space separated: . rest, - hold, 0 1 2 note, * whole chord, k s h o c t m drum hits, a+b together; suffixes ' , octave, # b semitone, ! accent, ?30 chance; T*n repeats; | is ignored"
        },
        "mode": {
          "enum": [
            "chord",
            "scale",
            "key"
          ],
          "description": "chord (default): 0 root, 1 third, 2 fifth; scale: steps above the chord root; key: degrees of the key"
        },
        "fit": {
          "type": "boolean",
          "description": "notes on the beat move to the nearest chord tone (melodies in key)"
        },
        "from": {
          "type": "string",
          "description": "plays this block's notes instead of a pattern of its own"
        },
        "forms": {
          "type": "array",
          "items": {
            "enum": [
              "whole",
              "head",
              "sequence",
              "slow",
              "shift",
              "answer"
            ]
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "{ section id: 0 | 0.25 | 0.5 | 0.75 | 1 }"
        },
        "fill": {
          "type": "boolean",
          "description": "a drum fill for the bar before a section change"
        },
        "mutate": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "how much it changes when it loops (default 1)"
        },
        "track": {
          "type": "string",
          "description": "older songs: the track it is on"
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "bars"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "unique"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "bars": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ],
          "description": "its length, or lengths to pick from"
        },
        "tracks": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "{ track id: 0 | 0.25 | 0.5 | 0.75 | 1 }"
        },
        "next": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "{ section id: 0 | 0.25 | 0.5 | 0.75 | 1 }"
        },
        "blocks": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/placed"
            }
          },
          "description": "the grid: { track id: [{ at: bar, block }] }; each block plays from its bar until the next one or the end, looping"
        },
        "chords": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/placedChords"
          },
          "description": "the grid: [{ at: bar, prog }]"
        }
      }
    },
    "placed": {
      "type": "object",
      "required": [
        "at",
        "block"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "block": {
          "type": "string",
          "description": "a block id"
        }
      }
    },
    "placedChords": {
      "type": "object",
      "required": [
        "at",
        "prog"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "prog": {
          "type": "string",
          "description": "a progression id"
        }
      }
    },
    "progression": {
      "type": "object",
      "required": [
        "id",
        "chords"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "unique"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "chords": {
          "type": "string",
          "description": "roman numerals (i–vii, 1–7) with an optional (shape) and :beats, e.g. \"i:4 VI:4 IV(sus2):2 .:2\"; . is no chord. Shapes: 7 triad sus2 sus4 power add9 six"
        },
        "scale": {
          "enum": [
            "major",
            "ionian",
            "dorian",
            "phrygian",
            "lydian",
            "mixolydian",
            "minor",
            "aeolian",
            "locrian",
            "harmonicMinor"
          ]
        },
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "{ section id: 0 | 0.25 | 0.5 | 0.75 | 1 }"
        }
      }
    },
    "mood": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "{ section id: 0 | 0.25 | 0.5 | 0.75 | 1 }"
        },
        "flow": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "description": "its sections in order: [[\"intro\", 1], [\"verse\", 2]]"
        },
        "loopFrom": {
          "type": "string",
          "description": "the section of its flow it loops from (default: the first)"
        },
        "then": {
          "enum": [
            "loop",
            "drift",
            "stop"
          ],
          "description": "after its flow: loop (default), drift among its sections, or stop"
        },
        "switch": {
          "enum": [
            "bar",
            "phrase",
            "section"
          ],
          "description": "how soon a change to it comes: the next bar (default), phrase (4 bars) or section"
        }
      }
    },
    "stinger": {
      "type": "object",
      "required": [
        "id",
        "beats",
        "parts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "discovery, alert, jump, reward, or your own"
        },
        "name": {
          "type": "string"
        },
        "at": {
          "enum": [
            "step",
            "beat",
            "half",
            "bar"
          ]
        },
        "beats": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 16
        },
        "chords": {
          "type": "string",
          "description": "roman numerals (i–vii, 1–7) with an optional (shape) and :beats, e.g. \"i:4 VI:4 IV(sus2):2 .:2\"; . is no chord. Shapes: 7 triad sus2 sus4 power add9 six"
        },
        "duck": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "how far the music ducks under it"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/part"
          },
          "minItems": 1
        },
        "then": {
          "type": "string",
          "description": "a mood with a flow: as the stinger ends, the music is there at once"
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "track"
      ],
      "additionalProperties": false,
      "properties": {
        "track": {
          "type": "string",
          "description": "the track it borrows"
        },
        "pattern": {
          "type": "string",
          "description": "steps, space separated: . rest, - hold, 0 1 2 note, * whole chord, k s h o c t m drum hits, a+b together; suffixes ' , octave, # b semitone, ! accent, ?30 chance; T*n repeats; | is ignored"
        },
        "block": {
          "type": "string",
          "description": "or: a block whose notes it plays"
        },
        "mode": {
          "enum": [
            "chord",
