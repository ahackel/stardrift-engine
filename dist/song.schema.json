{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stardrift song",
  "type": "object",
  "required": [
    "tracks",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 2
    },
    "name": {
      "type": "string"
    },
    "bpm": {
      "type": "number",
      "minimum": 30,
      "maximum": 300
    },
    "key": {
      "enum": [
        "C",
        "C#",
        "Db",
        "D",
        "D#",
        "Eb",
        "E",
        "F",
        "F#",
        "Gb",
        "G",
        "G#",
        "Ab",
        "A",
        "A#",
        "Bb",
        "B"
      ]
    },
    "scale": {
      "enum": [
        "major",
        "ionian",
        "dorian",
        "phrygian",
        "lydian",
        "mixolydian",
        "minor",
        "aeolian",
        "locrian",
        "harmonicMinor"
      ]
    },
    "stepsPerBeat": {
      "type": "integer",
      "minimum": 1,
      "description": "default 4"
    },
    "beatsPerBar": {
      "type": "integer",
      "minimum": 1,
      "description": "default 4"
    },
    "swing": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.6
    },
    "humanize": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.3
    },
    "variation": {},
    "blockChange": {},
    "fillChance": {},
    "layerChurn": {},
    "progStickiness": {},
    "transitBars": {},
    "leadIn": {},
    "breath": {
      "$ref": "#/definitions/breath"
    },
    "startSection": {
      "type": "string",
      "description": "the section it starts in (default: the first)"
    },
    "startMood": {
      "type": "string",
      "description": "the mood whose flow plays while the game asks for none (default: the first mood with a flow)"
    },
    "master": {
      "type": "object",
      "properties": {
        "glue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "fx": {},
    "instruments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/instrument"
      },
      "description": "{ id: instrument }"
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/track"
      }
    },
    "effectTracks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/effectTrack"
      },
      "description": "the grid: rows of effect blocks (filter sweeps, fades, echo throws) for the tracks they target"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/block"
      },
      "description": "the clips: short patterns that tracks play"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/section"
      }
    },
    "progressions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/progression"
      }
    },
    "moods": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/mood"
      },
      "description": "{ relaxed, wonder, exploring, tension, danger, action: { sections } }"
    },
    "stingers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/stinger"
      },
      "description": "discovery, alert, jump, reward"
    },
    "sounds": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sound"
      },
      "description": "game sounds made by synthesis: jump, coin, hit, explosion (music.sound(id))"
    }
  },
  "definitions": {
    "instrument": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "the editor's picture for it (guitar, keys, drums …); not played"
        },
        "type": {
          "const": "drums",
          "description": "a drum kit; left out, the instrument plays its layers"
        },
        "poly": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "notes at once (chords); 1: a new note ends the last"
        },
        "arp": {
          "type": "number",
          "minimum": 1,
          "maximum": 60,
          "description": "runs chords as a chip arpeggio, notes per second"
        },
        "arpChord": {
          "type": "boolean"
        },
        "guitar": {
          "type": "object",
          "additionalProperties": false,
          "description": "chords as a guitar plays them (poly 6): each string rings on; patterns strum (D U X) and pick (B A S1–S6)",
          "properties": {
            "shape": {
              "enum": [
                "open",
                "barre",
                "power",
                "high"
              ],
              "description": "how it fingers chords: open (default), barre, power, high (the top three strings)"
            },
            "strum": {
              "type": "number",
              "minimum": 0,
              "maximum": 40,
              "description": "ms between the strings of a strum (10)"
            }
          }
        },
        "legato": {
          "type": "boolean",
          "description": "a note into a held one is a hammer-on or slide: not picked or started again"
        },
        "kit": {
          "oneOf": [
            {
              "enum": [
                "clean",
                "orchestra",
                "rock",
                "chip"
              ]
            },
            {
              "type": "object",
              "description": "per-pad overrides { k: { pitch, decay, level } }"
            }
          ]
        },
        "preset": {
          "enum": [
            "clean",
            "orchestra",
            "rock",
            "chip"
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/layer"
          },
          "minItems": 1,
          "maxItems": 3,
          "description": "the sources, played together as one note: each with its own envelope, pitch and moves"
        },
        "unison": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        },
        "detune": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "ensemble": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "breath": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "noise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "older songs: breath as white noise"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "glide": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "scoop": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "vibrato": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rate": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 12
            },
            "delay": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "fx": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/effect"
          },
          "description": "its effects, in the order the sound goes through them"
        }
      }
    },
    "track": {
      "type": "object",
      "required": [
        "id",
        "instrument",
        "clips"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "unique"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "instrument": {
          "type": "string",
          "description": "an id in \"instruments\""
        },
        "octave": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "clips": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "a block id"
          },
          "description": "the blocks it plays"
        },
        "mode": {
          "enum": [
            "chord",
            "scale",
            "key"
          ]
        },
        "follow": {
          "type": "boolean",
          "description": "held notes move with the chord"
        },
        "stickiness": {
          "type": "number",
          "minimum": 0,
          "description": "how much it keeps its block (default 1.5)"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "echo": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reverb": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "double": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pump": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fade": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "effectTrack": {
      "type": "object",
      "description": "a row of effect blocks on the grid",
      "required": [
        "id",
        "target",
        "clips"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "unique, among the tracks too"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "target": {
          "oneOf": [
            {
              "const": "*"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "the tracks its effect blocks move: ids, or \"*\" for all (the whole mix)"
        },
        "except": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "a track id"
          },
          "description": "with \"target\": \"*\": the tracks it leaves alone"
        },
        "clips": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "an effect block id"
          },
          "description": "the effect blocks it plays"
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "unique"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "beats": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 64,
          "description": "its length; the pattern has beats × stepsPerBeat steps"
        },
        "pattern": {
          "type": "string",
          "description": "steps, space separated: . rest, - hold, 0 1 2 note, * whole chord, D U X down/up/dead strum and B A S1–S6 strings (guitars), k s h o c t m drum hits, a+b together; suffixes ' , octave, # b semitone, ! accent, ?30 chance; T*n repeats; | is ignored"
        },
        "mode": {
          "enum": [
            "chord",
            "scale",
            "key"
          ],
          "description": "chord (default): 0 root, 1 third, 2 fifth; scale: steps above the chord root; key: degrees of the key"
        },
        "fit": {
          "type": "boolean",
          "description": "notes on the beat move to the nearest chord tone (melodies in key)"
        },
        "from": {
          "type": "string",
          "description": "plays this block's notes instead of a pattern of its own"
        },
        "forms": {
          "type": "array",
          "items": {
            "enum": [
              "whole",
              "head",
              "sequence",
              "slow",
              "shift",
              "answer"
            ]
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "{ section id: 0 | 0.25 | 0.5 | 0.75 | 1 }"
        },
        "fill": {
          "type": "boolean",
          "description": "a drum fill for the bar before a section change"
        },
        "mutate": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "how much it changes when it loops (default 1)"
        },
        "track": {
          "type": "string",
          "description": "older songs: the track it is on"
        },
        "fx": {
          "type": "object",
          "description": "an effect block (on an effect track): one setting moved across the bars it is placed on",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "filter",
                "highpass",
                "volume",
                "echo",
                "reverb",
                "pan",
                "gate",
                "crush"
              ],
              "description": "filter (low pass, Hz), highpass (Hz), volume 0–1, echo and reverb (more send, 0–1), pan −1–1, gate (chop depth 0–1), crush 0–1"
            },
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            },
            "shape": {
              "enum": [
                "ramp",
                "hump",
                "wave",
                "step"
              ],
              "description": "ramp (default): from → to across its bars; hump: from → to → from; wave: between them every \"beats\"; hold: at to"
            },
            "beats": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 64,
              "description": "a wave: beats per cycle (4)"
            },
            "rate": {
              "type": "number",
              "minimum": 0.0625,
              "maximum": 4,
              "description": "a gate: beats per chop (0.25)"
            },
            "at": {}
          }
        },
        "voicing": {
          "enum": [
            "open",
            "barre",
            "power",
            "high"
          ],
          "description": "a guitar track: how this block fingers the chords (open, barre, power, high), in place of the instrument's"
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "bars"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "unique"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "bars": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ],
          "description": "its length, or lengths to pick from"
        },
        "tracks": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "{ track id: 0 | 0.25 | 0.5 | 0.75 | 1 }"
        },
        "next": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "{ section id: 0 | 0.25 | 0.5 | 0.75 | 1 }"
        },
        "blocks": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/placed"
            }
          },
          "description": "the grid: { track id: [{ at: bar, block }] }; each block plays from its bar until the next one or the end, looping"
        },
        "chords": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/placedChords"
          },
          "description": "the grid: [{ at: bar, prog }]"
        }
      }
    },
    "placed": {
      "type": "object",
      "required": [
        "at",
        "block"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "block": {
          "type": "string",
          "description": "a block id"
        }
      }
    },
    "placedChords": {
      "type": "object",
      "required": [
        "at",
        "prog"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "prog": {
          "type": "string",
          "description": "a progression id"
        }
      }
    },
    "progression": {
      "type": "object",
      "required": [
        "id",
        "chords"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "unique"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "chords": {
          "type": "string",
          "description": "roman numerals (i–vii, 1–7) with an optional (shape) and :beats, e.g. \"i:4 VI:4 IV(sus2):2 .:2\"; . is no chord. Shapes: 7 triad sus2 sus4 power add9 six"
        },
        "scale": {
          "enum": [
            "major",
            "ionian",
            "dorian",
            "phrygian",
            "lydian",
            "mixolydian",
            "minor",
            "aeolian",
            "locrian",
            "harmonicMinor"
          ]
        },
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "{ section id: 0 | 0.25 | 0.5 | 0.75 | 1 }"
        }
      }
    },
    "mood": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "{ section id: 0 | 0.25 | 0.5 | 0.75 | 1 }"
        },
        "flow": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "description": "its sections in order: [[\"intro\", 1], [\"verse\", 2]]"
        },
        "loopFrom": {
          "type": "string",
          "description": "the section of its flow it loops from (default: the first)"
        },
        "then": {
          "enum": [
            "loop",
            "drift",
            "stop"
          ],
          "description": "after its flow: loop (default), drift among its sections, or stop"
        },
        "switch": {
          "enum": [
            "bar",
            "phrase",
            "section"
          ],
          "description": "how soon a change to it comes: the next bar (default), phrase (4 bars) or section"
        }
      }
    },
    "stinger": {
      "type": "object",
      "required": [
        "id",
        "beats",
        "parts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "discovery, alert, jump, reward, or your own"
        },
        "name": {
          "type": "string"
        },
        "at": {
          "enum": [
            "step",
            "beat",
            "half",
            "bar"
          ]
        },
        "beats": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 16
        },
        "chords": {
          "type": "string",
          "description": "roman numerals (i–vii, 1–7) with an optional (shape) and :beats, e.g. \"i:4 VI:4 IV(sus2):2 .:2\"; . is no chord. Shapes: 7 triad sus2 sus4 power add9 six"
        },
        "duck": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "how far the music ducks under it"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/part"
          },
          "minItems": 1
        },
        "then": {
          "type": "string",
          "description": "a mood with a flow: as the stinger ends, the music is there at once"
        }
      }
    },
    "sound": {
      "type": "object",
      "required": [
        "id",
        "instrument"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "jump, coin, hit, or your own: music.sound(id)"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "the editor's picture for it; not played"
        },
        "instrument": {
          "type": "string",
          "description": "an id in \"instruments\" (not a drum kit): the instrument it plays, one note of it"
        },
        "note": {
          "type": "number",
          "minimum": 24,
          "maximum": 108,
          "description": "the note it plays, in midi notes (69: A4, 440 Hz)"
        },
        "length": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 4,
          "description": "seconds the note is held"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "echo": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reverb": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duck": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vary": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "key": {
          "type": "boolean",
          "description": "tuned to the nearest note of the chord playing"
        },
        "at": {
          "enum": [
            "now",
            "step",
            "beat"
          ],
          "description": "when it starts: now (default), the next step or the next beat"
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "pulse",
            "triangle",
            "wave",
            "string",
            "fm",
            "bowed",
            "sample",
            "noise"
          ],
          "description": "the source (pulse when left out)"
        },
        "wave": {
          "oneOf": [
            {
              "enum": [
                "soft",
                "sine",
                "saw",
                "warm",
                "organ",
                "hollow"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 15
              },
              "minItems": 32,
              "maxItems": 32
            }
          ]
        },
        "drawbars": {
          "type": "string",
          "pattern": "^[0-8]{9}$",
          "description": "a wave's tonewheel organ: the drawbars 16′ 5⅓′ 8′ 4′ 2⅔′ 2′ 1⅗′ 1⅓′ 1′, each 0–8, e.g. '888000000' (in place of wave)"
        },
        "smooth": {
          "type": "boolean",
          "description": "no 4-bit staircase"
        },
        "duty": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.5
        },
        "pwm": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4
            },
            "rate": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 8
            }
          }
        },
        "string": {
          "type": "object",
          "properties": {
            "decay": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10
            },
            "bright": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mute": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "position": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "pickup": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "pick": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "fm": {
          "type": "object",
          "properties": {
            "ratio": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 16
            },
            "index": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "env": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "feedback": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.5
            }
          }
        },
        "bow": {
          "type": "object",
          "properties": {
            "pressure": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "position": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "sample": {
          "type": "string",
          "description": "a recording in the library, e.g. cello, flute, violins"
        },
        "env": {
          "type": "object",
          "properties": {
            "a": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 4
            },
            "d": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 6
            },
            "s": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "r": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 8
            }
          }
        },
        "pitch": {
          "type": "number",
          "minimum": -36,
          "maximum": 36,
          "description": "semitones from the note"
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "delay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "seconds after the note starts"
        },
        "noise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "moves": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/move",
            "description": "on: pitch, level, duty, noise (pitch in semitones from the note)"
          }
        },
        "off": {
          "type": "boolean",
          "description": "muted for now"
        }
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "body",
            "wah",
            "drive",
            "filter",
            "crush",
            "eq",
            "ring",
            "vowel",
            "delay",
            "phaser",
            "chorus",
            "tremolo",
            "autopan",
            "leslie"
          ]
        },
        "off": {
          "type": "boolean",
          "description": "bypassed for now"
        },
        "type": {
          "description": "a filter's: low, high, band; a body's: violin, cello, acoustic, nylon, archtop, strings, horn, brass, ah, oh, oo, ee"
        },
        "bands": {
          "type": "array",
          "description": "a body of its own: [kind, Hz, Q, dB] each"
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "resonance": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 6
        },
        "beats": {
          "type": "number",
          "description": "in music: how long one sweep takes, in beats"
        },
        "rate": {
          "type": "number",
          "description": "in a sound: how fast it goes, Hz (a crush: its sample rate)"
        },
        "mode": {
          "enum": [
            "note",
            "flanger",
            "ensemble"
          ],
          "description": "a wah that follows the notes; a chorus as a flanger or a string machine's ensemble"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "amp": {
          "enum": [
            "guitar",
            "clean",
            "crunch",
            "lead",
            "bass"
          ]
        },
        "cutoff": {
          "type": "number",
          "minimum": 40,
          "maximum": 16000
        },
        "env": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "decay": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 2
        },
        "swell": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "bite": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bits": {
          "type": "number",
          "minimum": 2,
          "maximum": 12
        },
        "low": {
          "type": "number",
          "minimum": -12,
          "maximum": 12
        },
        "mid": {
          "type": "number",
          "minimum": -12,
          "maximum": 12
        },
        "midHz": {
          "type": "number",
          "minimum": 200,
          "maximum": 5000
        },
        "high": {
          "type": "number",
          "minimum": -12,
          "maximum": 12
        },
        "freq": {
          "type": "number",
          "minimum": 20,
          "maximum": 4000
        },
        "mix": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vowel": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "time": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1
        },
        "feedback": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "square": {
          "type": "boolean",
          "description": "a tremolo that chops"
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "ramp": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 4
        },
        "moves": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/move"
          }
        }
      }
    },
    "move": {
      "type": "object",
      "required": [
        "on",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "string",
          "description": "the setting it moves"
        },
        "shape": {
          "enum": [
            "ramp",
            "hump",
            "wave",
            "step"
          ],
          "description": "ramp (default), hump, wave, or step (at `at`)"
        },
        "to": {
          "type": "number",
          "description": "where the setting goes, in its own units"
        },
        "beats": {
          "type": "number",
          "minimum": 0.0625,
          "maximum": 16,
          "description": "in music: how long it takes from each note (a wave: its period)"
        },
        "rate": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60,
          "description": "in a sound: a wave's, Hz"
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "a step: where it steps, of the way through"
        },
        "every": {
          "type": "number",
          "minimum": 0,
          "description": "it starts over this often: beats in music, seconds in a sound; 0 once"
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "track"
      ],
      "additionalProperties": false,
      "properties": {
        "track": {
          "type": "string",
          "description": "the track it borrows"
        },
        "pattern": {
          "type": "string",
          "description": "steps, space separated: . rest, - hold, 0 1 2 note, * whole chord, D U X down/up/dead strum and B A S1–S6 strings (guitars), k s h o c t m drum hits, a+b together; suffixes ' , octave, # b semitone, ! accent, ?30 chance; T*n repeats; | is ignored"
        },
        "block": {
          "type": "string",
          "description": "or: a block whose notes it plays"
        },
        "mode": {
          "enum": [
            "chord",
            "scale",
            "key"
          ]
        }
      }
    },
    "breath": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "every": {
          "type": "number",
          "minimum": 1,
          "description": "about every this many bars the music thins out"
        },
        "bars": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "keep": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "a track id"
          }
        }
      }
    }
  }
}
